---
/** Preguntas frecuentes con <details>: funciona sin JavaScript. */
interface Props {
  faqs: { q: string; a: string; link?: { href: string; label: string } }[];
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-line overflow-hidden rounded-card-lg border border-line bg-surface">
  {
    faqs.map((faq) => (
      <details class="group">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 font-display text-base font-semibold text-ink transition-colors hover:bg-surface-2"
        >
          <span>{faq.q}</span>
          <svg
            viewBox="0 0 16 16"
            aria-hidden="true"
            class="mt-1 size-4 shrink-0 text-accent transition-transform duration-200 group-open:rotate-45"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M8 3v10M3 8h10" />
          </svg>
        </summary>
        <div class="px-5 pb-5 text-[0.9375rem] leading-relaxed text-muted">
          <p>{faq.a}</p>
          {faq.link && (
            <a
              href={faq.link.href}
              class="mt-2 inline-block rounded font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent"
            >
              {faq.link.label}
            </a>
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
