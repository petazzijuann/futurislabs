---
import { categories, modelLabelList, sortedMicroapps } from '../lib/library';
import MicroappCard from './MicroappCard.astro';

const apps = sortedMicroapps();
const cats = categories();
---

<section id="microapps" class="fl-container scroll-mt-24 py-20 md:py-28">
  <div class="max-w-2xl">
    <p class="fl-eyebrow">La biblioteca</p>
    <h2 class="mt-3 text-3xl md:text-4xl">Elige la herramienta que te hace falta</h2>
    <p class="fl-prose-lead mt-4">
      Cada microapp resuelve un problema puntual. Filtra por rubro o por forma de pago y entra a la
      que te sirva para ver cómo funciona.
    </p>
  </div>

  <div data-library class="mt-10">
    <div class="space-y-6">
      <fieldset>
        <legend class="font-display text-xs font-semibold tracking-widest text-muted uppercase">
          Categoría
        </legend>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-filter="category" data-value="all" aria-pressed="true" class="fl-chip">
            Todas
          </button>
          {
            cats.map((cat) => (
              <button
                type="button"
                data-filter="category"
                data-value={cat}
                aria-pressed="false"
                class="fl-chip"
              >
                {cat}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="font-display text-xs font-semibold tracking-widest text-muted uppercase">
          Forma de pago
        </legend>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-filter="model" data-value="all" aria-pressed="true" class="fl-chip">
            Todas
          </button>
          {
            modelLabelList.map(([value, label]) => (
              <button
                type="button"
                data-filter="model"
                data-value={value}
                aria-pressed="false"
                class="fl-chip"
              >
                {label}
              </button>
            ))
          }
        </div>
      </fieldset>
    </div>

    <p data-library-count aria-live="polite" class="mt-6 text-sm text-muted">
      {apps.length} microapps en la biblioteca.
    </p>

    <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        apps.map((app, index) => (
          <li data-card data-category={app.category} data-model={app.model}>
            <MicroappCard app={app} eager={index < 3} />
          </li>
        ))
      }
    </ul>

    <p data-library-empty hidden class="fl-card mt-6 p-8 text-center text-sm text-muted">
      No hay microapps con esa combinación de filtros todavía. Prueba con otra categoría.
    </p>
  </div>
</section>

<style>
  .fl-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--color-line-strong);
    background-color: transparent;
    padding: 0.4375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .fl-chip:hover {
    background-color: var(--color-surface-2);
  }

  .fl-chip[aria-pressed='true'] {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
</style>

<script>
  // Filtros de la biblioteca: sin recargar la página y sin dependencias.
  const root = document.querySelector<HTMLElement>('[data-library]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const count = root.querySelector<HTMLElement>('[data-library-count]');
    const empty = root.querySelector<HTMLElement>('[data-library-empty]');

    const active = { category: 'all', model: 'all' };

    function apply() {
      let visible = 0;

      for (const card of cards) {
        const matches =
          (active.category === 'all' || card.dataset.category === active.category) &&
          (active.model === 'all' || card.dataset.model === active.model);
        card.hidden = !matches;
        if (matches) visible++;
      }

      for (const chip of chips) {
        const group = chip.dataset.filter as 'category' | 'model';
        chip.setAttribute('aria-pressed', String(active[group] === chip.dataset.value));
      }

      if (count) {
        count.textContent =
          visible === 1 ? '1 microapp en la biblioteca.' : `${visible} microapps en la biblioteca.`;
      }
      if (empty) empty.hidden = visible > 0;
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const group = chip.dataset.filter as 'category' | 'model';
        active[group] = chip.dataset.value ?? 'all';
        apply();
      });
    }
  }
</script>
