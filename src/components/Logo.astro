---
/**
 * Lockup horizontal de Futurislabs: isotipo + wordmark.
 * Los archivos de marca viven en `src/assets/brand/` y Astro los optimiza.
 * El wordmark tiene dos versiones (tinta oscura / tinta clara) y se cambia
 * por `prefers-color-scheme` desde `.fl-logo-word*` en global.css.
 */
import { Image } from 'astro:assets';
import icon from '../assets/brand/futurislabs-icon.png';
import wordmark from '../assets/brand/futurislabs-wordmark.png';
import wordmarkDark from '../assets/brand/futurislabs-wordmark-dark.png';

interface Props {
  /** Solo el isotipo, sin el nombre. */
  iconOnly?: boolean;
  class?: string;
}

const { iconOnly = false, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <Image
    src={icon}
    alt={iconOnly ? 'Futurislabs' : ''}
    width={128}
    densities={[1, 2]}
    loading="eager"
    class="h-8 w-auto shrink-0"
  />
  {
    !iconOnly && (
      <>
        <Image
          src={wordmark}
          alt="Futurislabs"
          width={440}
          densities={[1, 2]}
          loading="eager"
          class="fl-logo-word h-[1.125rem] w-auto"
        />
        <Image
          src={wordmarkDark}
          alt="Futurislabs"
          width={440}
          densities={[1, 2]}
          loading="eager"
          class="fl-logo-word-dark h-[1.125rem] w-auto"
        />
      </>
    )
  }
</span>
