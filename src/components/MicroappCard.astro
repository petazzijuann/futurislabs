---
import type { Microapp } from '../data/microapps';
import { microappImage } from '../lib/images';
import { cardPrice, modelLabel } from '../lib/format';
import Cover from './Cover.astro';
import Badge from './Badge.astro';

interface Props {
  app: Microapp;
  /** La primera fila de la grilla carga su imagen sin diferir. */
  eager?: boolean;
}

const { app, eager = false } = Astro.props;
const cover = microappImage(app.image);
const soon = app.status === 'proximamente';
---

<a
  href={`/${app.slug}/`}
  class="fl-card group relative flex h-full flex-col overflow-hidden transition-[box-shadow,transform,border-color] duration-200 hover:-translate-y-1 hover:border-accent/35 hover:shadow-lift"
>
  <div class="relative aspect-[1200/630] overflow-hidden border-b border-line bg-surface-2">
    <Cover
      src={cover}
      alt={`Portada de ${app.name}`}
      loading={eager ? 'eager' : 'lazy'}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
    {
      soon && (
        <span class="absolute top-3 left-3">
          <Badge tone="signal">Próximamente</Badge>
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      <Badge tone="accent">{modelLabel[app.model]}</Badge>
      <Badge>{app.category}</Badge>
    </div>

    <h3 class="mt-3.5 font-display text-lg leading-snug font-semibold text-ink">
      {app.name}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{app.tagline}</p>

    <div class="mt-5 flex items-end justify-between gap-3 border-t border-line pt-4">
      <span class="font-display text-base font-semibold text-ink">{cardPrice(app)}</span>
      <span
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent transition-transform duration-200 group-hover:translate-x-0.5"
      >
        {soon ? 'Ver detalles' : 'Ver microapp'}
        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </span>
    </div>
  </div>
</a>
